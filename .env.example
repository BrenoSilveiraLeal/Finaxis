# Copie para .env e preencha. Nunca versione o .env.

PORT=5173
HOST=127.0.0.1
DB_FILE=data/finaxis.db

# --- Open Finance (Pluggy) -------------------------------------------------
# Sem estas duas variáveis o app roda em "modo demonstração" (bancos fictícios).
# Crie as credenciais em https://dashboard.pluggy.ai (o ambiente sandbox é gratuito).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Mostrar o banco de testes "Pluggy Bank" no widget (usuário user-ok / senha password-ok)
PLUGGY_SANDBOX=true
# Script do widget Pluggy Connect
PLUGGY_CONNECT_SCRIPT=https://cdn.pluggy.ai/pluggy-connect/v2.7.0/pluggy-connect.js

# --- Webhooks (tempo real) ------------------------------------------------
# O Pluggy só envia webhooks para uma URL https pública (não aceita localhost).
# Em desenvolvimento, use um túnel (ex.: cloudflared ou ngrok) e coloque a URL aqui.
# Sem isso, o servidor sincroniza ao abrir o app e a cada SYNC_INTERVAL_MINUTES.
PUBLIC_URL=
WEBHOOK_SECRET=troque-por-um-segredo-longo-e-aleatorio
SYNC_INTERVAL_MINUTES=60

# --- Produção ---------------------------------------------------------------
# Atrás de um proxy HTTPS (nginx, Render, Fly...): TRUST_PROXY=true e COOKIE_SECURE=true
TRUST_PROXY=false
COOKIE_SECURE=false

# Intervalo (s) das transações simuladas do modo demonstração
DEMO_LIVE_SECONDS=60
